{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCalendar",
  "version": "0.1.0",
  "identifier": "com.opencalendar.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [],
    "trayIcon": {
      "id": "tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "日历日程"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
